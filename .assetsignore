# Allowlist: ignore everything at the repo root, then re-include only the site.
/*
!/index.html
!/art-archive/
!/art-culture-audio/
!/art-research/
!/hermes-archive/
!/hermes-research/

# Inside the published folders, drop anything that is not site content.
CLAUDE.md
*.py
*.db
*.sqlite
*.sqlite3
*.env
.env*
__pycache__/
.venv/
node_modules/
pyproject.toml
uv.lock
requirements.txt

